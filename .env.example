# Source: keepa or demo
SOURCE=keepa

# Keepa
KEEPA_API_KEY=
KEEPA_DOMAIN_ID=9
KEEPA_PRICE_TYPE=0
KEEPA_DATE_RANGE=0
KEEPA_MAX_PAGES=1

# Filters
MIN_DISCOUNT_PERCENT=25
MIN_PRICE_EUR=5
MAX_PRICE_EUR=1500
MIN_RATING=4.0
ONLY_LOWEST_90=false
MUST_HAVE_AMAZON_OFFER=true
INCLUDE_CATEGORIES=
EXCLUDE_CATEGORIES=
TITLE_EXCLUDE_WORDS=renewed,reacondicionado
MAX_DEALS_PER_CYCLE=20

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_IMAGE=false
TELEGRAM_DISABLE_NOTIFICATION=false

# Optional Amazon Associates tag, e.g. mytag-21
AMAZON_ASSOCIATE_TAG=
AFFILIATE_DISCLOSURE=Enlace de afiliado

# Runtime
POLL_SECONDS=600
RESEND_COOLDOWN_HOURS=24
RESEND_MIN_EXTRA_DISCOUNT_PERCENT=5
DB_PATH=data/deals.sqlite3
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
DRY_RUN=false
