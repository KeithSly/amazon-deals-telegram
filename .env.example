# Source: keepa or demo
SOURCE=keepa

# Keepa / Amazon.es
KEEPA_API_KEY=
KEEPA_DOMAIN_ID=9
KEEPA_PRICE_TYPE=0
KEEPA_DATE_RANGE=3
KEEPA_MAX_PAGES=1
KEEPA_PRODUCT_UPDATE_HOURS=1
KEEPA_TRACKING_UPDATE_HOURS=1
KEEPA_TRACKING_ENABLED=true

# Deal filters
MIN_DISCOUNT_PERCENT=25
MIN_PRICE_EUR=5
MAX_PRICE_EUR=1500
MIN_RATING=4.0
ONLY_LOWEST_90=false
MUST_HAVE_AMAZON_OFFER=true
INCLUDE_CATEGORIES=
EXCLUDE_CATEGORIES=
TITLE_EXCLUDE_WORDS=renewed,reacondicionado
MAX_DEALS_PER_CYCLE=20

# Discovery / gaming. 599383031 = Videojuegos on Amazon.es.
DISCOVERY_ENABLED=true
DISCOVERY_ROOT_CATEGORIES=599383031
DISCOVERY_LOOKBACK_MINUTES=30
DISCOVERY_PER_PAGE=50
DISCOVERY_MAX_PAGES=1

# Preorders / restocks
PREORDER_ENABLED=true
PREORDER_LOOKBACK_MINUTES=60
RESTOCK_ENABLED=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHAT_ID=
# Required if you add personal/HOT watches.
TELEGRAM_PERSONAL_CHAT_ID=
TELEGRAM_SEND_IMAGE=false
TELEGRAM_DISABLE_NOTIFICATION=false

# Amazon Associates. Never used for personal/HOT links.
AMAZON_ASSOCIATE_TAG=
AFFILIATE_DISCLOSURE=Enlace de afiliado

# Runtime
POLL_SECONDS=600
RESEND_COOLDOWN_HOURS=24
RESEND_MIN_EXTRA_DISCOUNT_PERCENT=5
PRODUCT_EXPIRE_HOURS=720
DB_PATH=data/deals.sqlite3
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
DRY_RUN=false
